USE_PROCD=1
START=80

export TS_NO_LOGS_NO_SUPPORT=true

# Mirrors tailscale's checkOpenWRTUsingMWAN3() from router_linux.go but with
# corrected detection range. Upstream checks priority 2001-2004 only; some
# firmware (Quectel SDX-PINN) places mwan3 fwmark rules at 2005+.
check_mwan3_active() {
  [ -f /etc/config/mwan3 ] || return 1
  ip rule show 2>/dev/null | grep -qE '^20[0-9]{2}:.*fwmark' || return 1
  return 0
}

# If mwan3 is active and tailscale placed its ip rules at the default priority
# (5210-5270), shift them to 1310-1370 so they evaluate before mwan3's fwmark
# rules. If tailscale already detected mwan3 and used 1310-1370, do nothing.
# Matches the exact rules tailscale creates at ipPolicyPrefBase=1300.
ensure_mwan3_compat() {
  check_mwan3_active || return 0

  local tries=0
  while [ $tries -lt 15 ]; do
    if ip rule show 2>/dev/null | grep -qE '^(5210|1310):'; then
      break
    fi
    sleep 1
    tries=$((tries + 1))
  done

  # Tailscale handled it — nothing to do
  ip rule show 2>/dev/null | grep -q '^1310:' && return 0

  # Tailscale missed mwan3 — add corrected rules, then clean up originals
  if ip rule show 2>/dev/null | grep -q '^5210:'; then
    local family
    for family in -4 -6; do
      ip "$family" rule add priority 1310 fwmark 0x80000/0xff0000 lookup main
      ip "$family" rule add priority 1330 fwmark 0x80000/0xff0000 lookup default
      ip "$family" rule add priority 1350 fwmark 0x80000/0xff0000 unreachable
      ip "$family" rule add priority 1370 lookup 52
    done
    logger -t tailscale "mwan3 active but tailscale missed it; shifted ip rules to priority 1310-1370"
    # Wait briefly then remove stale default-priority rules (tailscale may
    # still be creating them during startup)
    sleep 3
    for family in -4 -6; do
      ip "$family" rule del priority 5210 2>/dev/null
      ip "$family" rule del priority 5230 2>/dev/null
      ip "$family" rule del priority 5250 2>/dev/null
      ip "$family" rule del priority 5270 2>/dev/null
    done
  fi
}

# On fw4/nftables systems (OpenWrt 23.05+) the input chain defaults to
# policy drop. Without a zone for tailscale0, the device is unreachable
# over tailscale. Create a minimal zone for basic reachability. The LuCI
# "Auto Configure Firewall" button upgrades this with forwarding, masq,
# and mss clamping when the user wants subnet routing / exit node features.
ensure_firewall_zone() {
  # Only needed on fw4 systems
  [ -x /sbin/fw4 ] || return 0

  # Check if a tailscale zone already exists
  local _sections _sec _zname
  _sections=$(uci show firewall 2>/dev/null | grep '=zone$' | cut -d= -f1)
  for _sec in $_sections; do
    _zname=$(uci -q get "${_sec}.name")
    [ "$_zname" = "tailscale" ] && return 0
  done

  # Ensure the network interface exists
  if [ -z "$(uci -q get network.tailscale)" ]; then
    uci set network.tailscale=interface
    uci set network.tailscale.proto='none'
    uci set network.tailscale.device='tailscale0'
    uci commit network
  fi

  # Create minimal zone: accept in/out, reject forward
  local zid
  zid=$(uci add firewall zone)
  uci set "firewall.${zid}.name=tailscale"
  uci set "firewall.${zid}.input=ACCEPT"
  uci set "firewall.${zid}.output=ACCEPT"
  uci set "firewall.${zid}.forward=REJECT"
  uci add_list "firewall.${zid}.network=tailscale"
  uci commit firewall

  /etc/init.d/network reload 2>/dev/null
  sleep 2
  /etc/init.d/firewall reload 2>/dev/null
  logger -t tailscale "created minimal fw4 zone for tailscale0 reachability"
}

start_service() {
  local state_file
  local port
  local std_err std_out

  config_load tailscale
  config_get_bool std_out "settings" log_stdout 1
  config_get_bool std_err "settings" log_stderr 1
  config_get port "settings" port 41641
  config_get state_file "settings" state_file /etc/tailscale/tailscaled.state
  config_get fw_mode "settings" fw_mode auto

  /usr/sbin/tailscaled --cleanup

  procd_open_instance
  procd_set_param command /usr/sbin/tailscaled

  procd_set_param env TS_NO_LOGS_NO_SUPPORT=true
  if [ "$fw_mode" != "auto" ]; then
    procd_append_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"
  fi

  procd_append_param command --port "$port"
  procd_append_param command --state "$state_file"

  procd_set_param respawn
  procd_set_param stdout "$std_out"
  procd_set_param stderr "$std_err"

  procd_close_instance
}

service_started() {
  ensure_firewall_zone
  ensure_mwan3_compat &
}

stop_service() {
  /usr/sbin/tailscaled --cleanup
}
