# Persistent Data Used counter (optional — non-fatal if missing). Off the hot
# path: a flag test per cycle, a sysfs sample every 15 cycles, a flash write
# every 5 min. Needs safe_tmp.sh (above) for the durable write.
if [ -f /usr/lib/qmanager/data_used.sh ]; then
    . /usr/lib/qmanager/data_used.sh
