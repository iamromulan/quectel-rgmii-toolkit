# =============================================================================
# LIBRARY LOADING
# =============================================================================

# Logging library
# GUARD with [ -f ] before dot-sourcing: a `.` on a MISSING file aborts a
# non-interactive BusyBox ash script (POSIX special builtin), so a bare
# `. FILE || {...}` fallback would never run. Guard, then stub in the else.
if [ -f /usr/lib/qmanager/qlog.sh ]; then
    . /usr/lib/qmanager/qlog.sh
else
    # Fallback if logging library not found
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
    qlog_at_cmd() { :; }
    qlog_lock() { :; }
    qlog_state_change() { :; }
    record_planned_reboot() { :; }
    mono_now_set() { _MONO=0; }
fi
qlog_init "poller"

# Backward-compatible aliases (used throughout this script)
log_info()  { qlog_info  "$1"; }
log_warn()  { qlog_warn  "$1"; }
log_error() { qlog_error "$1"; }

# AT command parsers
# Guarded with -f: BusyBox ash exits when `.` cannot find its file.
if [ -f /usr/lib/qmanager/parse_at.sh ]; then
    . /usr/lib/qmanager/parse_at.sh
else
    log_error "FATAL: Failed to load parse_at.sh"
    exit 1
fi

# On-demand radio cache (last-known mimo / TA / APN / WAN / DNS). Non-fatal:
# the poller no longer FETCHES these (the radio_details.sh CGI does) — it only
# READS the cache in write_cache(). If the lib is missing, the reader is a
# no-op and those display fields fall back to their initialized-empty defaults.
if [ -f /usr/lib/qmanager/ondemand_radio.sh ]; then
    . /usr/lib/qmanager/ondemand_radio.sh
else
    qlog_warn "ondemand_radio.sh not found, on-demand radio cache disabled"
    load_ondemand_cache() { :; }
    load_ondemand_cache_gated() { :; }
fi

# B4.1: root-safe /tmp helpers (trusted-file gate, atomic write). Missing lib: fail closed.
[ -f /usr/lib/qmanager/safe_tmp.sh ] && . /usr/lib/qmanager/safe_tmp.sh

# Ping-cache reader (conn_state_read). Without it connectivity reads as
# unknown every cycle — fail-closed, never "up".
if [ -f /usr/lib/qmanager/conn_state.sh ]; then
    . /usr/lib/qmanager/conn_state.sh
else
    qlog_warn "conn_state.sh not found, connectivity will read as unknown"
    conn_state_read() { CQ_STALE=1; CQ_STALE_REASON="missing"; return 1; }
    conn_state_why() { printf 'conn_state.sh missing'; }
fi

# Event detection
if [ -f /usr/lib/qmanager/events.sh ]; then
    . /usr/lib/qmanager/events.sh
else
    log_error "FATAL: Failed to load events.sh"
    exit 1
fi

# Email alerts channel lib (optional — non-fatal if missing)
if [ -f /usr/lib/qmanager/email_alerts.sh ]; then
    . /usr/lib/qmanager/email_alerts.sh
else
    qlog_warn "email_alerts.sh not found, email alerts disabled"
    email_alerts_init() { :; }
fi

# SMS alerts channel lib (optional — non-fatal if missing)
if [ -f /usr/lib/qmanager/sms_alerts.sh ]; then
