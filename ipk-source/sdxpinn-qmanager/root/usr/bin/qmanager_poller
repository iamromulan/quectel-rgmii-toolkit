#!/bin/sh
# =============================================================================
# qmanager_poller — QManager Background Poller Daemon
# =============================================================================
# Continuously gathers modem data and system metrics, writes to the
# JSON state cache at /tmp/qmanager_status.json.
#
# Strategy: the AT broker (qcmd) serialises modem access, so commands are issued
# back to back; no inter-command delay is needed.
#
# Tiers:
#   Tier 1 (Hot):    Every cycle (~2s)  — AT+QENG="servingcell", /proc reads,
#                                         AT+QRSRP, AT+QRSRQ, AT+QSINR (per-antenna signal)
#   Tier 1.5:        Every 5 cycles (10s) — watchcat state + ping history append,
#                                         SoC temperature (thermal sysfs, no AT)
#   Tier 2 (Warm):   Every 15 cycles, UI-ACTIVE ONLY, IDENTITY-ONLY — skipped while
#                                         unattended (idle/deep) so the poller stays
#                                         signal-only, avoiding the RM551E-GL MPSS
#                                         baseband SSR.
#                                         Identity:   AT+COPS?, AT+CPIN?, AT+QUIMSLOT?, AT+CNUM
#                                         See poll_tier2. (AT+QCAINFO runs every cycle, not here.)
#   On-demand only:  The former Tier-2 DATA-PLANE / L1 group (AT+CGCONTRDP,
#                                       AT+QMAP="WWAN", AT+QNWCFG="*_time_advance",
#                                       AT+QNWCFG="*_mimo_layers") is REMOVED from the
#                                       poller and fetched by cellular/radio_details.sh
#                                       only while its UI page is open. Last-known
#                                       values persist via /tmp/qmanager_ondemand.json,
#                                       read by write_cache(). See ondemand_radio.sh.
#   Boot-only:     Once at startup    — AT+CVERSION, AT+CGSN, AT+CIMI, AT+QCCID,
#                                       AT+CNUM, AT+QGETCAPABILITY,
#                                       AT+QNWPREFCFG="policy_band"
#
# Libraries (sourced at startup):
#   /usr/lib/qmanager/qlog.sh         — Centralized logging
#   /usr/lib/qmanager/parse_at.sh     — AT command response parsers
#   /usr/lib/qmanager/ondemand_radio.sh — Last-known on-demand radio cache reader
#   /usr/lib/qmanager/events.sh       — Network event detection
#   /usr/lib/qmanager/data_used.sh    — Persistent Data Used counter (30 s sample)
#   /usr/lib/qmanager/qmi_merge.sh    — QMI LTE signal gap-fill overlay (optional)
#
# Install location: /usr/bin/qmanager_poller
# =============================================================================

# --- Configuration -----------------------------------------------------------
CACHE_FILE="/tmp/qmanager_status.json"
CACHE_TMP="/tmp/qmanager_status.json.tmp"
LONG_FLAG="/tmp/qmanager_long_running"
FORCE_TIER2_FLAG="/tmp/qmanager_force_tier2"
REFRESH_POLICY_FLAG="/tmp/qmanager_refresh_policy_band"
# Raised by cellular/settings.sh during a SIM slot switch so poller qcmd traffic
# does not contend with the CFUN/QUIMSLOT sequence. mtime-bounded (below) so a
# crashed CGI that never clears it cannot mute polling forever.
SIM_SWITCH_FLAG="/tmp/qmanager_sim_switch_active"
SIM_SWITCH_MAX_AGE=60
# Static hardware band-capability file (shipped from repo, force-copied on every
# install/upgrade). Read once at boot to populate hw_* globals.
HW_BANDS_FILE="/etc/qmanager/supported_bands_hw.env"
# Boot-cached policy_band-derived supported bands (queried once per poller life).
SUPPORTED_BANDS_FILE="/tmp/qmanager_supported_bands.env"
POLL_INTERVAL=2        # seconds between Tier 1 cycles
TIER1_5_EVERY=5        # Tier 1.5 (watchcat state + ping history) runs every N Tier-1 cycles
TIER2_EVERY=15         # Tier 2 runs every N Tier-1 cycles
# Dev-only AT tap (B5.29 parse-parity corpus). Off unless the root-owned flag
# exists; when off it costs one [ -f ] builtin per AT call. Records the raw qcmd
# reply of each poller AT call plus the parser globals at the end of each AT
# cycle into a 200-slot ring. Removed by init.d stop_service and uninstall.
TAP_FLAG="/var/run/qmanager/poller_tap"
TAP_DIR="/var/run/qmanager/tap"
TAP_RING=200

# Constants for the fork-free string helpers (_rm_chars, _first_line_with, ...).
_CR=$(printf '\r')
_US=$(printf '\037')
_NL='
'
# Per-cycle clock, set at the top of poll_cycle: _NOW = wall-clock epoch (one
# `date` fork per cycle), _MONO_TOP = uptime seconds at that moment.
_NOW=""
_MONO_TOP=""
# Last valid heartbeat epoch. A momentarily empty/garbage heartbeat read (a CGI
# mid-write, or the file briefly absent) reuses it instead of dropping to deep.
_HB_LAST=0
# Uptime (s) when the heartbeat value last changed. The tier age is measured on
# this monotonic clock, so a NITZ/ntpd wall-clock step cannot flip the tier.
_HB_SEEN_MONO=0
# write_cache failures in a row (logged on the first one only).
_WC_FAILS=0
# Runtime dir for the on-demand cache stamp (and the dev tap). Once, at start.
[ -d /var/run/qmanager ] || mkdir -p /var/run/qmanager 2>/dev/null

# --- Adaptive (UI-aware tiered) backoff --------------------------------------
# When no browser is open the poller graduates AT-port reads to a slower cadence
# while keeping local-only work (proc metrics, ping read, write_cache) at the
# base POLL_INTERVAL so watchdog .connectivity + root .timestamp stay fresh.
# AP_* are runtime-resolved from quecmanager.poller.* (resolve_poller_config);
# the values below are the built-in defaults used when the UCI section is absent.
UI_ACTIVE_FILE="/tmp/qmanager_ui_active"          # heartbeat epoch, touched by status CGIs
POLLER_RELOAD_FLAG="/tmp/qmanager_poller_reload"  # live-reload handshake (CGI drops it)
AP_ENABLED=1
AP_ACTIVE_GRACE=20      # seconds since last UI hit to stay in Active
AP_IDLE_INTERVAL=15     # AT-read cadence (s) in the Idle tier
AP_IDLE_THRESHOLD=300   # seconds of idle before dropping to Deep
AP_DEEP_INTERVAL=60     # AT-read cadence (s) in the Deep tier
ap_tier="active"        # current tier ("active"|"idle"|"deep"); emitted in .device.poller_tier
# Prometheus scrape hold: each authenticated scrape writes "<mode> <uptime_s>"
# here. While it is younger than the TTL (uptime clock), balanced caps the tier
# age at idle and realtime pins active. It only ever raises the cadence.
METRICS_SCRAPE_FILE="/var/run/qmanager/metrics_scrape"
METRICS_LEASE_TTL=120
# Uptime (s) of the last AT+QENG reply carrying +QENG: lines, and of the last
# AT+QCAINFO reply parsed; 0 = never. Emitted as .device.serving_read_mono /
# .device.ca_read_mono so a consumer can age the radio data (deep tier freezes CA).
_SERVING_READ_MONO=0
_CA_READ_MONO=0
# 1 when this cycle's AT+QENG reply was parsed (AT owns the serving cell this
# cycle, so the QMI overlay stays off). Reset at the top of poll_cycle.
_QENG_PARSED=0
# QMI gap-fill state (qmi_merge.sh; defaults for when the lib is absent).
# Published as lte.source and device.qmi_read_mono / qmi_state / qmi_ssr_count.
lte_source="at"
_QMI_READ_MONO=0
_QMI_STATE=""
_QMI_SSR=0

# Signal history (NDJSON file for chart data)
SIGNAL_HISTORY_FILE="/tmp/qmanager_signal_history.json"
SIGNAL_HISTORY_MAX=60  # 2 min at 2s intervals (Tier 1 cadence)
# History files are trimmed (tail + mv) only once they exceed MAX + this slack,
# so the fork pair is paid every ~30 appends instead of every append. Readers
# tolerate the slack: the CGIs read the whole file and the signal chart slices
# the last few rows.
HISTORY_TRIM_SLACK=30

# Ping history (NDJSON file for latency chart data)
PING_HISTORY_FILE="/tmp/qmanager_ping_history.json"
PING_HISTORY_MAX=8640  # ~38h at the measured ~16s row cadence (not 10s)

# --- State Variables ---------------------------------------------------------
