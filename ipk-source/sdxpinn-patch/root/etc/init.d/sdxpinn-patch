#!/bin/sh /etc/rc.common

START=14

LOG_FILE="/tmp/sdxpinn-patch.log"

start() {
    rm -f "$LOG_FILE" >/dev/null 2>&1
    touch "$LOG_FILE"
    exec >>"$LOG_FILE" 2>&1

    echo "sdxpinn-patch service starting - $(date)"

    # PCIe ASPM fix
    # The platform defaults to powersupersave which causes TX watchdog
    # timeouts on the RTL8125 PCIe NIC (and adds latency to all PCIe).
    # Set global policy to performance — this is a mains-powered device.
    if [ -f /sys/module/pcie_aspm/parameters/policy ]; then
        echo "Setting PCIe ASPM policy to performance..."
        echo performance > /sys/module/pcie_aspm/parameters/policy
        echo "ASPM policy set to: $(cat /sys/module/pcie_aspm/parameters/policy)"
    fi

    # Autosleep disable — platform ships with autosleep=mem, held awake
    # only by wakelocks. Disable entirely for mains-powered CPE.
    if [ -f /sys/power/autosleep ]; then
        CURRENT_AUTOSLEEP=$(cat /sys/power/autosleep)
        if [ "$CURRENT_AUTOSLEEP" != "off" ]; then
            echo off > /sys/power/autosleep
            echo "Autosleep disabled (was: $CURRENT_AUTOSLEEP)"
        else
            echo "Autosleep already disabled"
        fi
    fi

    echo "sdxpinn-patch service complete - $(date)"
}

stop() {
    echo "sdxpinn-patch: nothing to undo"
}

restart() {
    start
}
