#!/bin/sh /etc/rc.common

START=90

USE_PROCD=1

PROG=/usr/sbin/tailscale
PROGD=/usr/sbin/tailscaled
CONFIG_PATH=/var/lib/tailscale

service_triggers() {
	procd_add_reload_trigger "tailscale"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/tailscale reload
}

section_enabled() {
	config_get_bool enabled "$1" 'enabled' 0
	[ $enabled -gt 0 ]
}

find_lan2wan_forwarding() {
	local result
	result=$(uci show firewall | grep "firewall.@forwarding\[[0-9]\+\]\.src='lan'" -B 1 -A 1 | grep "firewall.@forwarding\[[0-9]\+\]\.dest='wan'" | grep -o '[0-9]\+')
	[ -z "$result" ] && result=$(uci show firewall | grep "firewall.@forwarding\[[0-9]\+\]\.src='lan_wan'" -B 1 -A 1 | grep "firewall.@forwarding\[[0-9]\+\]\.dest='wan'" | grep -o '[0-9]\+')
	echo "$result"
}

custom_instance() {
	local cfg="$1"
	local acceptRoutes hostname acceptDNS advertiseExitNode exitNode advertiseRoutes s2s subnetRoutes flags loginServer authkey std_out std_err
	local ARGS=" up --reset"

	if ! section_enabled "$cfg"; then
		echo "disabled in config"
		return 1
	fi

	config_get_bool acceptRoutes $cfg 'acceptRoutes'
	config_get hostname $cfg 'hostname'
	config_get_bool acceptDNS $cfg 'acceptDNS'
	config_get_bool advertiseExitNode $cfg 'advertiseExitNode'
	config_get exitNode $cfg 'exitNode'
	config_get advertiseRoutes $cfg 'advertiseRoutes'
	config_get_bool s2s $cfg 's2s'
	config_get flags $cfg 'flags'
	config_get loginServer $cfg 'loginServer'
	config_get authkey $cfg 'authkey'
	config_get_bool std_out $cfg 'log_stdout'
	config_get_bool std_err $cfg 'log_stderr'

	[ "$acceptRoutes" = "1" ] && ARGS="$ARGS --accept-routes=true"
	[ -n "$hostname" ] && ARGS="$ARGS --hostname=$hostname"
	[ "$acceptDNS" = "0" ] && ARGS="$ARGS --accept-dns=false"
	[ "$advertiseExitNode" = "1" ] && ARGS="$ARGS --advertise-exit-node"
	[ -n "$exitNode" ] && ARGS="$ARGS --exit-node=$exitNode --exit-node-allow-lan-access=true"
	[ -n "$advertiseRoutes" ] && ARGS="$ARGS --advertise-routes=$(echo $advertiseRoutes | tr ' ' ',')"
	[ "$s2s" = "1" ] && ARGS="$ARGS --snat-subnet-routes=false"
	[ -n "$flags" ] && ARGS="$ARGS $flags"
	[ -n "$loginServer" ] && ARGS="$ARGS --login-server=$loginServer"
	[ -n "$authkey" ] && ARGS="$ARGS --authkey=$authkey"

	# Write setup script with config baked in
	cat > /tmp/tailscale-setup.sh <<SETUP_EOF
#!/bin/sh
exec 1000>&-
. /lib/functions.sh

TS_ARGS="$ARGS"
acceptDNS="$acceptDNS"
exitNode="$exitNode"

find_lan2wan_fwd() {
	local r
	r=\$(uci show firewall | grep "firewall.@forwarding\[[0-9]\+\]\.src='lan'" -B 1 -A 1 | grep "firewall.@forwarding\[[0-9]\+\]\.dest='wan'" | grep -o '[0-9]\+')
	[ -z "\$r" ] && r=\$(uci show firewall | grep "firewall.@forwarding\[[0-9]\+\]\.src='lan_wan'" -B 1 -A 1 | grep "firewall.@forwarding\[[0-9]\+\]\.dest='wan'" | grep -o '[0-9]\+')
	echo "\$r"
}

# Wait for tailscaled socket
count=0
while ! /usr/sbin/tailscale status >/dev/null 2>&1 && ! /usr/sbin/tailscale status 2>&1 | grep -q 'Logged out\|NeedsLogin'; do
	sleep 1
	count=\$((count + 1))
	[ "\$count" -ge 120 ] && exit 18
done

/usr/sbin/tailscale \$TS_ARGS

# Wait for interface + IP (up to 1 hour)
count=0
while [ -z "\$(ifconfig | grep tailscale | awk '{print \$1}')" ] || [ -z "\$(/usr/sbin/tailscale ip -4 2>/dev/null)" ]; do
	sleep 2
	count=\$((count + 1))
	[ "\$count" -ge 30 ] && exit 19
done

if [ "\$acceptDNS" = "1" ]; then
	MagicDNSSuffix=\$(/usr/sbin/tailscale status --json | awk -F'"' '/"MagicDNSSuffix"/ {last=\$(NF-1)} END {print last}')
	sed -i '/100.100.100.100/d' /etc/dnsmasq.conf
	echo "server=/\$MagicDNSSuffix/100.100.100.100" >> /etc/dnsmasq.conf
	/etc/init.d/dnsmasq reload
fi

ts0=\$(ifconfig | grep tailscale | awk '{print \$1}')
if [ -z "\$(uci -q get network.tailscale)" ]; then
	uci set network.tailscale='interface'
	ts_ip=\$(/usr/sbin/tailscale ip -4)
	uci set network.tailscale.proto='static'
	uci set network.tailscale.ipaddr="\$ts_ip"
	uci set network.tailscale.netmask='255.192.0.0'
	uci set network.tailscale.device="\$ts0"
fi

lan2wan=\$(find_lan2wan_fwd)
if [ -n "\$exitNode" ]; then
	uci set firewall.@defaults[0].forward='REJECT'
	[ -n "\$lan2wan" ] && uci set firewall.@forwarding[\$lan2wan].enabled='0'
else
	uci -q delete firewall.@forwarding[\$lan2wan].enabled
fi

config_load 'tailscale'
config_get subnetRoutes 'settings' 'subnetRoutes'
if [ -n "\$subnetRoutes" ]; then
	i=1
	ts_ip=\$(/usr/sbin/tailscale ip -4)
	for route in \$subnetRoutes; do
		uci set network.ts_subnet\${i}='route'
		uci set network.ts_subnet\${i}.interface='tailscale'
		uci set network.ts_subnet\${i}.target="\$route"
		uci set network.ts_subnet\${i}.gateway="\$ts_ip"
		i=\$((i + 1))
	done
else
	for route in \$(uci show network | grep 'network.ts_subnet[0-9]\+=route' | grep -o 'network.ts_subnet[0-9]\+'); do
		uci -q delete "\$route"
	done
fi

config_get access 'settings' 'access'
if [ -n "\$access" ]; then
	if [ -z "\$(uci -q get firewall.tszone)" ]; then
		uci set firewall.tszone='zone'
		uci set firewall.tszone.input='ACCEPT'
		uci set firewall.tszone.output='ACCEPT'
		uci set firewall.tszone.forward='ACCEPT'
		uci set firewall.tszone.masq='1'
		uci set firewall.tszone.mtu_fix='1'
		uci set firewall.tszone.name='tailscale'
		uci set firewall.tszone.network='tailscale'
	fi
else
	uci -q delete firewall.tszone
fi
case "\$access" in *tsfwlan*) uci set firewall.tsfwlan=forwarding; uci set firewall.tsfwlan.dest='lan'; uci set firewall.tsfwlan.src='tailscale';; *) uci -q delete firewall.tsfwlan;; esac
case "\$access" in *tsfwwan*) uci set firewall.tsfwwan=forwarding; uci set firewall.tsfwwan.dest='wan'; uci set firewall.tsfwwan.src='tailscale';; *) uci -q delete firewall.tsfwwan;; esac
case "\$access" in *lanfwts*) uci set firewall.lanfwts=forwarding; uci set firewall.lanfwts.dest='tailscale'; uci set firewall.lanfwts.src='lan';; *) uci -q delete firewall.lanfwts;; esac
case "\$access" in *wanfwts*) uci set firewall.wanfwts=forwarding; uci set firewall.wanfwts.dest='tailscale'; uci set firewall.wanfwts.src='wan';; *) uci -q delete firewall.wanfwts;; esac

[ -n "\$(uci changes network)" ] && uci commit network && /etc/init.d/network reload
[ -n "\$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload
rm -f /tmp/tailscale-setup.sh /var/run/tailscale-setup.pid
SETUP_EOF
	chmod +x /tmp/tailscale-setup.sh

	# Launch as a fully detached daemon — survives init script exit
	start-stop-daemon -S -b -m -p /var/run/tailscale-setup.pid -x /tmp/tailscale-setup.sh
}

start_instance() {
	local cfg="$1"
	local port config_path fw_mode std_out std_err state_file
	local ARGS=""

	if ! section_enabled "$cfg"; then
		echo "disabled in config"
		return 1
	fi

	config_get port $cfg 'port'
	config_get state_file $cfg 'state_file'
	[ -z "$state_file" ] && state_file="/etc/tailscale/tailscaled.state"
	config_get fw_mode $cfg 'fw_mode'
	config_get_bool std_out $cfg 'log_stdout'
	config_get_bool std_err $cfg 'log_stderr'

	[ -d "$(dirname "$state_file")" ] || mkdir -p "$(dirname "$state_file")"
	[ -d $CONFIG_PATH ] || mkdir -p $CONFIG_PATH

	/usr/sbin/tailscaled --cleanup

	[ -n "$port" ] && ARGS="$ARGS --port $port"
	[ -n "$state_file" ] && ARGS="$ARGS --state $state_file"

	procd_open_instance
	procd_set_param command $PROGD $ARGS

	procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"
	procd_set_param env GOGC=50
	procd_set_param env GOMEMLIMIT=110MiB

	procd_set_param respawn
	procd_set_param stdout "$std_out"
	procd_set_param stderr "$std_err"
	procd_close_instance
}

start_service() {
	config_load 'tailscale'
	config_foreach start_instance 'tailscale'
	config_foreach custom_instance 'tailscale'
}

stop_instance() {
	local cfg="$1"
	/usr/sbin/tailscaled --cleanup

	# Remove dnsmasq settings
	sed -i '/100.100.100.100/d' /etc/dnsmasq.conf
	/etc/init.d/dnsmasq reload

	# Remove network settings
	uci -q delete network.tailscale
	uci -q delete network.ts_lan
	for route in $(uci show network | grep 'network.ts_subnet[0-9]\+=route' | grep -o 'network.ts_subnet[0-9]\+'); do
		uci -q delete $route
	done

	# Remove firewall settings
	lan2wan=$(find_lan2wan_forwarding)
	uci -q delete firewall.@forwarding[$lan2wan].enabled
	uci -q delete firewall.tszone
	uci -q delete firewall.tsfwlan
	uci -q delete firewall.tsfwwan
	uci -q delete firewall.lanfwts
	uci -q delete firewall.wanfwts
	[ -n "$(uci changes network)" ] && uci commit network && /etc/init.d/network reload
	[ -n "$(uci changes firewall)" ] && uci commit firewall && /etc/init.d/firewall reload

	# Remove existing link or folder
	rm -rf $CONFIG_PATH
}

stop_service() {
	for pid in $(ps | grep '/usr/sbin/tailscale ' | grep -v tailscaled | grep -v grep | awk '{print $1}'); do
		kill -9 "$pid" 2>/dev/null
	done
	if [ -f /var/run/tailscale-setup.pid ]; then
		kill -9 "$(cat /var/run/tailscale-setup.pid)" 2>/dev/null
		rm -f /var/run/tailscale-setup.pid /tmp/tailscale-setup.sh
	fi
	config_load 'tailscale'
	config_foreach stop_instance 'tailscale'
}

reload_service() {
	stop
	start
}
